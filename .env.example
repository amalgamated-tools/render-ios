# Local secrets for live testing. Copy this file to `.env` and fill in a real value.
# `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#   # then edit .env and paste your key
#
# A Render API key (starts with `rnd_`). Create one at:
#   https://dashboard.render.com/u/settings/api-keys
# Used by Scripts/smoke.sh to exercise the live API for the per-phase smoke test.
# The app itself does NOT read this file — it stores the key you enter on-device in the Keychain.
RENDER_API_KEY=
